{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "services": {
    "backoffice": {
      "root": "apps/backoffice/vercel",
      "installCommand": "true",
      "buildCommand": "bash ../../../scripts/build-vercel-ui.sh backoffice backoffice",
      "outputDirectory": "public",
      "routes": [
        {
          "handle": "filesystem"
        },
        {
          "src": "/backoffice/assets/.*",
          "status": 404
        },
        {
          "src": "/backoffice(?:/.*)?",
          "dest": "/backoffice/index.html"
        }
      ],
      "devCommand": "node ../../../scripts/serve-vercel-ui.mjs backoffice"
    },
    "client-ui": {
      "root": "apps/client-ui/vercel",
      "installCommand": "true",
      "buildCommand": "bash ../../../scripts/build-vercel-ui.sh client-ui root",
      "outputDirectory": "public",
      "routes": [
        {
          "src": "/user/?",
          "status": 308,
          "headers": {
            "Location": "/"
          }
        },
        {
          "src": "/user/((?!(?:api|v1|healthz|backoffice|user|assets)(?:/|$))(?=[^/]{1,63}(?:/|$))[a-z0-9]+(?:-[a-z0-9]+)*(?:/(?:products/[1-9][0-9]*|cart/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|checkout/(?:return|cancel)))?)",
          "status": 308,
          "headers": {
            "Location": "/$1"
          }
        },
        {
          "handle": "filesystem"
        },
        {
          "src": "/assets/.*",
          "status": 404
        },
        {
          "src": "/",
          "dest": "/index.html"
        },
        {
          "src": "/(?!(?:api|v1|healthz|backoffice|user|assets)(?:/|$))(?=[^/]{1,63}(?:/|$))[a-z0-9]+(?:-[a-z0-9]+)*(?:/(?:products/[1-9][0-9]*|cart/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|checkout/(?:return|cancel)))?",
          "dest": "/index.html"
        }
      ],
      "devCommand": "node ../../../scripts/serve-vercel-ui.mjs client-ui"
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.api.vercel",
      "devCommand": "cd services/api && cargo run --locked -p api -- server"
    }
  },
  "rewrites": [
    {
      "source": "/_cron",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/backoffice",
      "destination": {
        "service": "backoffice"
      }
    },
    {
      "source": "/backoffice/(.*)",
      "destination": {
        "service": "backoffice"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client-ui"
      }
    }
  ],
  "crons": [
    {
      "path": "/_cron",
      "schedule": "0 0 * * *"
    }
  ]
}
