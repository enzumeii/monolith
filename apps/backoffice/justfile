# Default target
default:
    @just --list

# Create .env if missing
setup:
    #!/usr/bin/env bash
    if [ ! -f .env ]; then
      echo '→ Scaffolding .env from template...'
      printf '%s\n' \
        'RUN_ENV=local' > .env
      echo '  .env created successfully'
    else
      echo '→ .env already exists, leaving it untouched.'
    fi
# Dev: run the fullstack app with hot reload (requires the Dioxus CLI).
# The internal API must be running separately (see services/api).
serve:
    dx serve

# Run the server binary directly (no hot reload; needs a prebuilt web bundle).
run:
    cargo run -p backoffice --features server

# Check: format check + strict lint for both server and web (wasm) targets
check:
    cargo fmt --check -p backoffice
    cargo clippy -p backoffice --features server --all-targets -- -D warnings
    cargo clippy -p backoffice --features web --target wasm32-unknown-unknown --all-targets -- -D warnings

# Fix: apply format fix + lint fix (server target)
fix:
    cargo fmt -p backoffice
    cargo clippy -p backoffice --features server --fix --allow-dirty --allow-staged -- -D warnings

# Test: run backoffice tests (validates the server target builds)
test:
    cargo test -p backoffice --features server
