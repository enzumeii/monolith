web_target := "wasm32-unknown-unknown"

default:
    @just --list

setup:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v dx >/dev/null || { echo 'Install dioxus-cli 0.7.10 first'; exit 1; }
    case "$(rustup target list --installed)" in
      *{{web_target}}*) ;;
      *) echo 'Run rustup target add {{web_target}} first'; exit 1 ;;
    esac
    if [ ! -f .env ]; then
      printf '%s\n' 'RUN_ENV=local' > .env
    fi

build:
    dx build --web --fullstack --no-default-features --package backoffice

check:
    cargo fmt --check -p backoffice
    cargo clippy --locked -p backoffice --features server --all-targets -- -D warnings
    cargo clippy --locked -p backoffice --no-default-features --features web --target {{web_target}} --all-targets -- -D warnings

fix:
    cargo fmt -p backoffice
    cargo clippy --locked -p backoffice --features server --fix --allow-dirty --allow-staged -- -D warnings
    cargo clippy --locked -p backoffice --no-default-features --features web --target {{web_target}} --fix --allow-dirty --allow-staged -- -D warnings

serve:
    #!/usr/bin/env bash
    set -euo pipefail
    binding="$(cargo run -q -p backoffice --features server -- --print-bind)"
    read -r host port <<< "$binding"
    exec dx serve --web --fullstack --no-default-features --addr "$host" --port "$port"

run: build
    ../../target/dx/backoffice/debug/web/server

test:
    cargo test --locked -p backoffice --features server
