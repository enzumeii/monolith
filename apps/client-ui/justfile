web_target := "wasm32-unknown-unknown"

# List available client commands.
default:
    @just --list

# Check formatting and strict native/WASM lint.
check:
    cargo fmt --check -p client-ui
    cargo clippy --locked -p client-ui --all-targets -- -D warnings
    cargo clippy --locked -p client-ui --target {{web_target}} --all-targets -- -D warnings

# Fix: apply format fix + lint fix
fix:
    cargo fmt -p client-ui
    cargo clippy --locked -p client-ui --fix --allow-dirty --allow-staged -- -D warnings

# Run client-ui tests; pass --coverage to generate target/coverage/client-ui/lcov.info.
test coverage="":
    bash ../../scripts/test-coverage.sh client-ui {{quote(coverage)}}

# Run the existing test suite; coverage instrumentation is supplied by the public test recipe.
[private]
_test:
    cargo test --locked -p client-ui

# Build the client-only web bundle for local use.
build:
    dx build --web --package client-ui

# Serve the client shell using the local public application.toml.
serve:
    dx serve --web --addr 127.0.0.1 --port 8085

# Check pinned Dioxus and the installed WASM target before local development.
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v dx >/dev/null || { echo 'Install dioxus-cli 0.7.10 first'; exit 1; }
    rustup target list --installed | rg -q '^{{web_target}}$' || { echo 'Run rustup target add {{web_target}} first'; exit 1; }
