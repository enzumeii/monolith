  "query": "\n                UPDATE admin\n                SET \n                    username = COALESCE($2, username),\n                    password_hash = COALESCE($3, password_hash),\n                    updated_at = NOW()\n                WHERE id = $1\n                RETURNING id, username, password_hash, role AS \"role: AdminRole\", created_at, updated_at\n            ",
