{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE refresh_tokens AS rt\n            SET revoked_at = NOW()\n            FROM admin AS a\n            WHERE rt.admin_id = a.id\n              AND rt.token_hash = $1\n              AND rt.revoked_at IS NULL\n              AND rt.expires_at > NOW()\n            RETURNING rt.id AS token_id, rt.admin_id, a.username,\n                      a.role AS \"role: DbAdminRole\", rt.expires_at, rt.revoked_at\n            ",
