  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                rt.id AS token_id,\n                rt.admin_id,\n                a.username,\n                a.role AS \"role: AdminRole\",\n                rt.expires_at,\n                rt.revoked_at\n            FROM refresh_tokens rt\n            INNER JOIN admin a ON a.id = rt.admin_id\n            WHERE rt.token_hash = $1\n            ",
