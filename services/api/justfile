set dotenv-load := true
set export := true

biome_version := "2.5.15"
biome := "../../.tools/biome-" + biome_version

# Default target
default:
    @just --list

# Install pinned Biome for GraphQL/JSON formatting and create .env if missing.
setup: setup-formatter
    #!/usr/bin/env bash
    if [ ! -f .env ]; then
      echo '→ Scaffolding .env from template...'
      printf '%s\n' \
        'RUN_ENV=local' \
        'DATABASE_URL=postgres://user:pass@127.0.0.1:5432/core' \
        'SHOPIFY_ACCESS_TOKEN=' \
        "JWT_SECRET=$(python3 -c 'import secrets; print(secrets.token_hex(32))')" > .env
      echo '  Generated a random signing key in .env; keep it private.'
    else
      echo '→ .env already exists, leaving it untouched.'
    fi
    printf '%s\n' 'Optional Shopify client: set SHOPIFY_ACCESS_TOKEN in .env and client.shopify.admin_api_url in application.toml.'

# Start Postgres, run migrations, and start the API service
run:
    @echo "🚀 Starting PostgreSQL container..."
    docker compose -f docker-compose.yml up -d

    @echo "⏳ Waiting for PostgreSQL to be ready..."
    @until docker compose -f docker-compose.yml exec -T postgres pg_isready -U postgres > /dev/null 2>&1; do \
        sleep 1; \
    done

    @echo "⚡ Running database migrations..."
    cargo sqlx migrate run

    @echo "🔥 Starting API service..."
    cargo run -p api

# Stop the dev Postgres container
db-down:
    docker compose -f docker-compose.yml down

# Run API tests, then TCP E2E with Docker PostgreSQL; always stop Compose afterward.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo test --locked
    trap 'docker compose -p e2e -f docker-compose-e2e.yml down -v' EXIT
    docker compose -p e2e -f docker-compose-e2e.yml up -d --wait postgres
    cargo api-e2e

# Install the pinned standalone Biome binary for macOS or Linux.
setup-formatter:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -x "{{biome}}" ]; then
      exit 0
    fi
    case "$(uname -s)-$(uname -m)" in
      Darwin-arm64) platform=darwin-arm64 ;;
      Darwin-x86_64) platform=darwin-x64 ;;
      Linux-aarch64) platform=linux-arm64 ;;
      Linux-x86_64) platform=linux-x64 ;;
      *) echo 'Unsupported Biome platform: use macOS or Linux on ARM64/x64.' >&2; exit 1 ;;
    esac
    mkdir -p ../../.tools
    download=$(mktemp "{{biome}}.XXXXXX")
    trap 'rm -f "$download"' EXIT
    curl --fail --location --retry 3 --output "$download" \
      "https://github.com/biomejs/biome/releases/download/%40biomejs/biome%40{{biome_version}}/biome-$platform"
    chmod +x "$download"
    "$download" --version
    mv "$download" "{{biome}}"

# Check repository GraphQL/JSON formatting and API Rust formatting.
format-check:
    cd ../.. && ".tools/biome-{{biome_version}}" format .
    cargo fmt --check -p api

# Format repository GraphQL/JSON files and API Rust code.
format:
    cd ../.. && ".tools/biome-{{biome_version}}" format --write .
    cargo fmt -p api

# Check Rust/GraphQL/JSON formatting and strict API lint.
check: format-check
    cargo clippy --locked -p api --all-targets -- -D warnings

# Apply lint fixes, prepare SQLx metadata, then format Rust/GraphQL/JSON.
fix:
    cargo clippy --locked -p api --fix --allow-dirty --allow-staged -- -D warnings
    cargo sqlx prepare
    just format

# Recreate the dev Postgres database (drop + create)
reset-db:
    sqlx database drop -y && sqlx database create
