set dotenv-load := true
set export := true

dprint_version := "0.63.0"
export DPRINT_CACHE_DIR := justfile_directory() / ".tools/cache"

# Default target
default:
    @just --list

# Install pinned dprint and fill private settings from Bitwarden when installed, otherwise local defaults.
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo install --locked dprint --version {{dprint_version}} --root .tools
    .tools/bin/dprint config install
    python3 scripts/setup-env.py

# Start Postgres and the local Docker Blob emulator, migrate, and run the API.
run:
    #!/usr/bin/env bash
    set -euo pipefail
    blob_owned=true
    api_pid=
    if [[ -n "$(docker compose -f docker-compose.yml ps --status running -q local-blob)" ]]; then blob_owned=false; fi
    cleanup() {
      if [[ -n "$api_pid" ]]; then kill "$api_pid" 2>/dev/null || true; wait "$api_pid" 2>/dev/null || true; fi
      if [[ "$blob_owned" == true ]]; then docker compose -f docker-compose.yml stop local-blob; fi
    }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    docker compose -f docker-compose.yml up -d --wait postgres local-blob
    cargo sqlx migrate run
    cargo build --locked -p api --bin api
    ../../target/debug/api &
    api_pid=$!
    while kill -0 "$api_pid" 2>/dev/null; do
      if [[ -z "$(docker compose -f docker-compose.yml ps --status running -q local-blob)" ]]; then
        echo 'Local Blob emulator stopped' >&2
        exit 1
      fi
      sleep 1
    done
    wait "$api_pid"

# Run the API with existing dependencies and no migrations; RUN_ENV selects local/prod overrides.
server:
    cargo run --locked -p api -- server

# Stop the dev Postgres container
db-down:
    docker compose -f docker-compose.yml down

# Run API and TCP E2E tests with Docker cleanup; pass --coverage for an API LCOV report.
test coverage="":
    bash ../../scripts/test-coverage.sh api {{quote(coverage)}}

# Run the existing test suite; coverage instrumentation is supplied by the public test recipe.
[private]
_test:
    #!/usr/bin/env bash
    set -euo pipefail
    trap 'docker compose -p "${E2E_COMPOSE_PROJECT:-e2e}" -f docker-compose-e2e.yml down -v' EXIT
    docker compose -p "${E2E_COMPOSE_PROJECT:-e2e}" -f docker-compose-e2e.yml up -d --wait postgres local-blob
    cargo test --locked
    cargo api-e2e

# Check setup helper behavior (Python 3), Rust/GraphQL/JSON formatting, and strict API lint.
check:
    python3 -m unittest discover -s scripts/tests -p 'test_setup_env.py'
    .tools/bin/dprint check
    cargo fmt --check -p api
    cargo clippy --locked -p api --all-targets -- -D warnings

# Apply lint fixes, prepare SQLx metadata, then format Rust/GraphQL/JSON.
fix:
    cargo clippy --locked -p api --fix --allow-dirty --allow-staged -- -D warnings
    cargo sqlx prepare
    .tools/bin/dprint fmt
    cargo fmt -p api

# Recreate the dev Postgres database (drop + create)
reset-db:
    sqlx database drop -y && sqlx database create
