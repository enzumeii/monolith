set dotenv-load := true
set export := true

dprint_version := "0.63.0"
export DPRINT_CACHE_DIR := justfile_directory() / ".tools/cache"

# Default target
default:
    @just --list

# Install pinned dprint, cache plugins, and scaffold private local settings without replacing existing values.
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo install --locked dprint --version {{dprint_version}} --root .tools
    .tools/bin/dprint config install
    if [ ! -f .env ]; then
      echo '→ Scaffolding .env from template...'
      printf '%s\n' \
        'RUN_ENV=local' \
        'DATABASE_URL=postgres://user:pass@127.0.0.1:5432/core' \
        'SHOPIFY_ACCESS_TOKEN=' \
        'RESEND_API_KEY=' \
        'PAYPAL_CLIENT_ID=' \
        'PAYPAL_CLIENT_SECRET=' \
        'STRIPE_SECRET_KEY=' \
        "JWT_SECRET=$(python3 -c 'import secrets; print(secrets.token_hex(32))')" > .env
      echo '  Generated a random signing key in .env; keep it private.'
    else
      echo '→ .env already exists, preserving its values.'
    fi
    for key in RESEND_API_KEY PAYPAL_CLIENT_ID PAYPAL_CLIENT_SECRET STRIPE_SECRET_KEY; do
      if ! grep -Eq "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" .env; then
        printf '\n%s=\n' "$key" >> .env
      fi
    done
    printf '%s\n' 'Optional Stripe client: set STRIPE_SECRET_KEY in .env before reading Stripe data.'
    printf '%s\n' 'Optional PayPal reporting: set PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET in .env; select the PayPal base URL in application.toml.'
    python3 - <<'PY_SENDER'
    import pathlib, re, secrets
    path = pathlib.Path('.env')
    text = path.read_text()
    token = secrets.token_hex(4)
    sender = {
        'NAME': f'Synthetic Sender {token}',
        'PHONE': f'000{secrets.randbelow(10_000_000):07d}',
        'EMAIL': 'shipping@enzumeii.com',
        'ADDRESS': f'{secrets.randbelow(9999) + 1} Synthetic Street {token}',
        'SUB_DISTRICT': 'Synthetic Subdistrict',
        'DISTRICT': 'Synthetic District',
        'PROVINCE': 'Bangkok',
        'POSTCODE': f'10{secrets.randbelow(1000):03d}',
        'COUNTRY_CODE': 'TH',
    }
    for field, value in sender.items():
        key = f'SHIPPING_SENDER_{field}'
        pattern = re.compile(rf'(?m)^[ \t]*(?:export[ \t]+)?{key}[ \t]*=(.*)$')
        matches = list(pattern.finditer(text))
        empty = ('', "''", '""')
        existing = next((match.group(1).strip() for match in matches if match.group(1).strip() not in empty), None)
        line = f'{key}={existing}' if existing else f'{key}="{value}"'
        text = pattern.sub(lambda match: line if match.group(1).strip() in empty else match.group(0), text) if matches else text.rstrip('\n') + '\n' + line + '\n'
    path.write_text(text)
    PY_SENDER
    printf '%s\n' 'Synthetic local sender values are scaffolded in .env; replace them with your shipping sender profile before real use.'
    printf '%s\n' 'Optional Resend client: set RESEND_API_KEY in .env to your Resend API key before sending email.'
    printf '%s\n' 'Optional Shopify client: set SHOPIFY_ACCESS_TOKEN in .env and client.shopify.admin_api_url in application.toml.'

# Start Postgres, run migrations, and start the API service
run:
    @echo "🚀 Starting PostgreSQL container..."
    docker compose -f docker-compose.yml up -d

    @echo "⏳ Waiting for PostgreSQL to be ready..."
    @until docker compose -f docker-compose.yml exec -T postgres pg_isready -U postgres > /dev/null 2>&1; do \
        sleep 1; \
    done

    @echo "⚡ Running database migrations..."
    cargo sqlx migrate run

    @echo "🔥 Starting API service..."
    cargo run -p api

# Stop the dev Postgres container
db-down:
    docker compose -f docker-compose.yml down

# Run API and TCP E2E tests with Docker cleanup; pass --coverage for an API LCOV report.
test coverage="":
    bash ../../scripts/test-coverage.sh api {{quote(coverage)}}

# Run the existing test suite; coverage instrumentation is supplied by the public test recipe.
[private]
_test:
    #!/usr/bin/env bash
    set -euo pipefail
    trap 'docker compose -p "${E2E_COMPOSE_PROJECT:-e2e}" -f docker-compose-e2e.yml down -v' EXIT
    docker compose -p "${E2E_COMPOSE_PROJECT:-e2e}" -f docker-compose-e2e.yml up -d --wait postgres
    cargo test --locked
    cargo api-e2e

# Check Rust/GraphQL/JSON formatting and strict API lint.
check:
    .tools/bin/dprint check
    cargo fmt --check -p api
    cargo clippy --locked -p api --all-targets -- -D warnings

# Apply lint fixes, prepare SQLx metadata, then format Rust/GraphQL/JSON.
fix:
    cargo clippy --locked -p api --fix --allow-dirty --allow-staged -- -D warnings
    cargo sqlx prepare
    .tools/bin/dprint fmt
    cargo fmt -p api

# Recreate the dev Postgres database (drop + create)
reset-db:
    sqlx database drop -y && sqlx database create
