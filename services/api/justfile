set dotenv-load := true
set export := true

dprint_version := "0.63.0"
export DPRINT_CACHE_DIR := justfile_directory() / ".tools/cache"

# Default target
default:
    @just --list

# Install pinned dprint and prepare private settings; use --local (default) or --qa.
setup mode="--local":
    #!/usr/bin/env bash
    set -euo pipefail
    case {{quote(mode)}} in --local|--qa) ;; *) echo 'Usage: just setup [--local|--qa]' >&2; exit 1 ;; esac
    cargo install --locked dprint --version {{dprint_version}} --root .tools
    .tools/bin/dprint config install
    python3 scripts/setup-env.py {{quote(mode)}}

# Start local dependencies and the API with --local (default) or isolated --qa credentials.
run mode="--local":
    #!/usr/bin/env bash
    set -euo pipefail
    case {{quote(mode)}} in
      --local) exec just --dotenv-path .env _run local ;;
      --qa)
        if [[ ! -f .env.qa || ! -f application.qa.toml ]]; then
          echo 'QA requires .env.qa and application.qa.toml. Run just setup --qa first.' >&2
          exit 1
        fi
        unset RUN_ENV DATABASE_URL JWT_SECRET CRON_SECRET SHOPIFY_ACCESS_TOKEN RESEND_API_KEY
        unset PAYPAL_CLIENT_ID PAYPAL_CLIENT_SECRET STRIPE_SECRET_KEY S3_ACCESS_KEY_ID S3_SECRET_ACCESS_KEY
        unset SHIPPING_SENDER_NAME SHIPPING_SENDER_PHONE SHIPPING_SENDER_EMAIL SHIPPING_SENDER_ADDRESS
        unset SHIPPING_SENDER_SUB_DISTRICT SHIPPING_SENDER_DISTRICT SHIPPING_SENDER_PROVINCE
        unset SHIPPING_SENDER_POSTCODE SHIPPING_SENDER_COUNTRY_CODE
        exec just --dotenv-path .env.qa _run qa ;;
      *) echo 'Usage: just run [--local|--qa]' >&2; exit 1 ;;
    esac

# Run the shared local Docker/API lifecycle with the selected private environment.
[private]
_run mode:
    #!/usr/bin/env bash
    set -euo pipefail
    export RUN_ENV={{quote(mode)}}
    if [[ "$RUN_ENV" == qa ]]; then
      case "${STRIPE_SECRET_KEY:-}" in
        *[[:space:]]*) echo 'QA requires a Stripe test server key. Run just setup --qa.' >&2; exit 1 ;;
        sk_test_?*|rk_test_?*) ;;
        *) echo 'QA requires a Stripe test server key. Run just setup --qa.' >&2; exit 1 ;;
      esac
      if [[ -z "${DATABASE_URL:-}" ]]; then
        echo 'QA requires DATABASE_URL in .env.qa. Run just setup --qa.' >&2
        exit 1
      fi
    fi
    s3_owned=true
    api_pid=
    if [[ -n "$(docker compose -f docker-compose.yml ps --status running -q local-s3)" ]]; then s3_owned=false; fi
    cleanup() {
      if [[ -n "$api_pid" ]]; then kill "$api_pid" 2>/dev/null || true; wait "$api_pid" 2>/dev/null || true; fi
      if [[ "$s3_owned" == true ]]; then docker compose -f docker-compose.yml stop local-s3; fi
    }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    docker compose -f docker-compose.yml up -d --wait postgres
    if [[ "$s3_owned" == true ]]; then
      docker compose -f docker-compose.yml up -d --wait local-s3
    else
      docker compose -f docker-compose.yml up -d --wait --no-recreate local-s3
    fi
    docker compose -f docker-compose.yml run --rm --no-deps local-s3-init
    cargo sqlx --no-dotenv migrate run
    cargo build --locked -p api --bin api
    ../../target/debug/api &
    api_pid=$!
    while kill -0 "$api_pid" 2>/dev/null; do
      if [[ -z "$(docker compose -f docker-compose.yml ps --status running -q local-s3)" ]]; then
        echo 'Local S3 service stopped' >&2
        exit 1
      fi
      sleep 1
    done
    wait "$api_pid"

# Stop the dev Postgres container
db-down:
    docker compose -f docker-compose.yml down

# Run API and TCP E2E tests with Docker cleanup; pass --coverage for an API LCOV report.
test coverage="":
    bash ../../scripts/test-coverage.sh api {{quote(coverage)}}

# Run the existing test suite; coverage instrumentation is supplied by the public test recipe.
[private]
_test:
    #!/usr/bin/env bash
    set -euo pipefail
    trap 'docker compose -p "${E2E_COMPOSE_PROJECT:-e2e}" -f docker-compose-e2e.yml down -v' EXIT
    docker compose -p "${E2E_COMPOSE_PROJECT:-e2e}" -f docker-compose-e2e.yml up -d --wait postgres local-s3
    docker compose -p "${E2E_COMPOSE_PROJECT:-e2e}" -f docker-compose-e2e.yml run --rm local-s3-init
    cargo test --locked
    cargo api-e2e

# Check setup helper behavior (Python 3), Rust/GraphQL/JSON formatting, and strict API lint.
check:
    python3 -m unittest discover -s scripts/tests -p 'test_setup_env.py'
    .tools/bin/dprint check
    cargo fmt --check -p api
    cargo clippy --locked -p api --all-targets -- -D warnings
    cargo clippy --locked -p api --test e2e -- -D warnings

# Apply lint fixes, prepare SQLx metadata, then format Rust/GraphQL/JSON.
fix:
    cargo clippy --locked -p api --fix --allow-dirty --allow-staged -- -D warnings
    cargo clippy --locked -p api --test e2e --fix --allow-dirty --allow-staged -- -D warnings
    cargo sqlx prepare
    .tools/bin/dprint fmt
    cargo fmt -p api

# Recreate the dev Postgres database (drop + create)
reset-db:
    sqlx database drop -y && sqlx database create
