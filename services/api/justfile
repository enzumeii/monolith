set dotenv-load := true
set export := true

# Default target
default:
    @just --list

# Create .env if missing
setup:
    #!/usr/bin/env bash
    if [ ! -f .env ]; then
      echo '→ Scaffolding .env from template...'
      printf '%s\n' \
        'RUN_ENV=local' \
        'DATABASE_URL=postgres://user:pass@127.0.0.1:5432/core' \
        "JWT_SECRET=$(python3 -c 'import secrets; print(secrets.token_hex(32))')" > .env
      echo '  Generated a random signing key in .env; keep it private.'
    else
      echo '→ .env already exists, leaving it untouched.'
    fi

# Start Postgres, run migrations, and start the API service
run:
    @echo "🚀 Starting PostgreSQL container..."
    docker compose -f docker-compose.yml up -d

    @echo "⏳ Waiting for PostgreSQL to be ready..."
    @until docker compose -f docker-compose.yml exec -T postgres pg_isready -U postgres > /dev/null 2>&1; do \
        sleep 1; \
    done

    @echo "⚡ Running database migrations..."
    cargo sqlx migrate run

    @echo "🔥 Starting API service..."
    cargo run -p api

# Stop the dev Postgres container
db-down:
    docker compose -f docker-compose.yml down

# Run shared contracts, domain WASM check, and API tests using Compose PostgreSQL.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo test --locked -p domain --no-default-features
    cargo check --locked -p domain --no-default-features --target wasm32-unknown-unknown
    cargo test --locked -p api --lib
    docker compose -p e2e -f docker-compose-e2e.yml up -d --wait postgres
    export E2E_DATABASE_URL="${E2E_DATABASE_URL:-postgres://e2e:e2e@127.0.0.1:5433/e2e}"
    export DATABASE_URL="$E2E_DATABASE_URL"
    export JWT_SECRET=abababababababababababababababababababababababababababababababab
    export API_HOST=127.0.0.1
    export API_PORT="${E2E_API_PORT:-3100}"
    export E2E_API_URL="http://${API_HOST}:${API_PORT}"
    cargo build --locked -p api --bins
    run_dir="$(mktemp -d)"
    ../../target/debug/api > "$run_dir/api.log" 2>&1 &
    api_pid=$!
    trap 'kill "$api_pid" 2>/dev/null || true; wait "$api_pid" 2>/dev/null || true; rm -rf "$run_dir"' EXIT
    ready=false
    for attempt in {1..60}; do
      kill -0 "$api_pid" 2>/dev/null || { cat "$run_dir/api.log"; exit 1; }
      if curl --silent --fail --max-time 1 "$E2E_API_URL/healthz" >/dev/null; then ready=true; break; fi
      sleep 0.25
    done
    "$ready" || { cat "$run_dir/api.log"; exit 1; }
    cargo api-e2e --locked
    cargo test --locked -p api --lib postgres_cleanup -- --ignored

# Bootstrap the existing E2E PostgreSQL container without resetting records.
e2e-db:
    docker compose -p e2e -f docker-compose-e2e.yml up -d --wait postgres

# Explicitly create an admin from an operator-supplied Argon2 PHC hash file.
bootstrap-admin username hash_file role="SUPER_ADMIN":
    #!/usr/bin/env bash
    set -euo pipefail
    hash="$(cat {{quote(hash_file)}})"
    psql "${DATABASE_URL:?DATABASE_URL is required}" -X \
      --set=username={{quote(username)}} --set=role={{quote(role)}} \
      --set=password_hash="$hash" --file=bootstrap_admin.sql

# Check: format + lint check (no changes)
check:
    cargo fmt --check -p api
    cargo clippy --locked -p api --all-targets -- -D warnings

# Format: apply format + lint fix
fix:
    cargo fmt -p api
    cargo clippy --locked -p api --fix --allow-dirty --allow-staged -- -D warnings
    cargo sqlx prepare

# Recreate the dev Postgres database (drop + create)
reset-db:
    sqlx database drop -y && sqlx database create
