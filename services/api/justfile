set dotenv-load := true
set export := true

# Default target
default:
    @just --list

# Create .env if missing
setup:
    #!/usr/bin/env bash
    if [ ! -f .env ]; then
      echo '→ Scaffolding .env from template...'
      printf '%s\n' \
        'RUN_ENV=local' \
        'DATABASE_URL=postgres://user:pass@127.0.0.1:5432/core' \
        'SHOPIFY_ACCESS_TOKEN=' \
        "JWT_SECRET=$(python3 -c 'import secrets; print(secrets.token_hex(32))')" > .env
      echo '  Generated a random signing key in .env; keep it private.'
    else
      echo '→ .env already exists, leaving it untouched.'
    fi
    printf '%s\n' 'Optional Shopify client: set SHOPIFY_ACCESS_TOKEN in .env and client.shopify.admin_api_url in application.toml.'

# Start Postgres, run migrations, and start the API service
run:
    @echo "🚀 Starting PostgreSQL container..."
    docker compose -f docker-compose.yml up -d

    @echo "⏳ Waiting for PostgreSQL to be ready..."
    @until docker compose -f docker-compose.yml exec -T postgres pg_isready -U postgres > /dev/null 2>&1; do \
        sleep 1; \
    done

    @echo "⚡ Running database migrations..."
    cargo sqlx migrate run

    @echo "🔥 Starting API service..."
    cargo run -p api

# Stop the dev Postgres container
db-down:
    docker compose -f docker-compose.yml down

# Run API tests, then TCP E2E with Docker PostgreSQL; always stop Compose afterward.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo test --locked
    trap 'docker compose -p e2e -f docker-compose-e2e.yml down -v' EXIT
    docker compose -p e2e -f docker-compose-e2e.yml up -d --wait postgres
    cargo api-e2e

# Check: format + lint check (no changes)
check:
    cargo fmt --check -p api
    cargo clippy --locked -p api --all-targets -- -D warnings

# Format: apply format + lint fix
fix:
    cargo fmt -p api
    cargo clippy --locked -p api --fix --allow-dirty --allow-staged -- -D warnings
    cargo sqlx prepare

# Recreate the dev Postgres database (drop + create)
reset-db:
    sqlx database drop -y && sqlx database create
