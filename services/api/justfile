set export := true
set dotenv-filename := ".env.local"

# Default target
default:
    @just --list

# Start Postgres, run migrations, and start the API service
api-run:
    @echo "🚀 Starting PostgreSQL container..."
    docker compose -f docker-compose.yml up -d

    @echo "⏳ Waiting for PostgreSQL to be ready..."
    @until docker compose -f docker-compose.yml exec -T postgres pg_isready -U postgres > /dev/null 2>&1; do \
        sleep 1; \
    done

    @echo "⚡ Running database migrations..."
    cargo sqlx migrate run

    @echo "🔥 Starting API service..."
    cargo run -p api

# Stop the dev Postgres container
api-db-down:
    docker compose -f docker-compose.yml down

# Run all tests: unit tests (no Docker) + e2e tests (Postgres via docker-compose-e2e.yml)
api-test:
    cargo test -p api --lib
    docker compose -p e2e -f docker-compose-e2e.yml up -d --wait
    cargo e2e
    docker compose -p e2e -f docker-compose-e2e.yml down -v

# Check: format check + lint check (no changes)
api-check:
    cargo fmt --check -p api
    cargo clippy -p api --all-targets -- -D warnings

# Format: apply format fix + lint fix
api-fix:
    cargo fmt -p api
    cargo clippy -p api --fix --allow-dirty --allow-staged -- -D warnings

# Recreate the dev Postgres database (drop + create)
api-reset-db:
    sqlx database drop -y && sqlx database create
